  "findings": [
    {
      "id": "F1",
      "severity": "BLOCKING",
      "file": "internal/review/review.go",
      "line": 335,
      "behavior": "v2 self-review detection compares raw reviewer and change-author strings",
      "evidence": "A complete v2 record with change_author=\"reviewer\" and reviewer=\"reviewer \" exits 0 with status PASS and no issues in work/review-final/probes/self-review-whitespace.out.json; the comparison is input.Reviewer == input.ChangeAuthor at internal/review/review.go:335.",
      "consequence": "An author can add whitespace to the reviewer identity and obtain a passing independent-review artifact; audit.Build gates only on reviewReport.Status at internal/audit/audit.go:119-120, so this bypass can flow into a complete audit receipt.",
      "confidence": "HIGH",
      "fix": "Canonicalize or reject surrounding whitespace in both identities before the independence comparison, and add a v2 hostile-input test plus audit regression coverage.",
      "disposition": "OPEN"
    },
    {
      "id": "F2",
      "severity": "IMPROVEMENT",
      "file": "internal/review/review.go",
      "line": 510,
      "behavior": "runtime accepts a finding with line=0 while the published v2 JSON Schema requires line >= 1",
      "evidence": "work/review-final/probes/line-zero.out.json is accepted by the candidate CLI with status PASS; internal/review/review.go:510 rejects only negative lines, while harness/schemas/review-finding.schema.json:11 declares minimum=1.",
      "consequence": "The same review artifact can pass the CLI but fail a Draft 2020-12 schema validator, so producers and downstream gates disagree about whether the record is valid.",
      "confidence": "HIGH",
      "fix": "Align the runtime and schema by rejecting line=0 in the runtime (or explicitly make line zero legal in the schema), then add a schema/runtime parity test.",
      "disposition": "OPEN"
    }
  ]
