{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/rule.schema.json",
  "title": "Clean Code doctrine rule",
  "type": "object",
  "required": ["id", "title", "classification", "summary", "evidence", "applicability", "default_severity", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z]+-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "classification": { "enum": ["deterministic", "semantic", "convention", "architectural"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "applicability": { "type": "string", "minLength": 1 },
    "default_severity": { "enum": ["blocking", "review", "advisory"] },
    "source": { "type": "string", "minLength": 1 },
    "exceptions": { "type": "array", "items": { "type": "string" } },
    "false_positives": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
