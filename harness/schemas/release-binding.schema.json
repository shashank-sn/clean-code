{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.dev/schemas/release-binding.schema.json",
  "title": "Revision-bound release contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "base_revision", "final_revision", "requirement_digest", "change_set_digest", "policy_revision", "tests", "reviews", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "repository": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "minLength": 1},
    "final_revision": {"type": "string", "minLength": 1},
    "requirement_digest": {"type": "string", "minLength": 1},
    "change_set_digest": {"type": "string", "minLength": 1},
    "policy_revision": {"type": "string", "minLength": 1},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}}
  },
  "$defs": {
    "test": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "requirement_ids", "revision", "status", "required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "revision": {"type": "string", "minLength": 1},
        "status": {"enum": ["PLANNED", "NOT_RUN", "NOT_AVAILABLE", "INAPPLICABLE", "FAIL", "PASS"]},
        "artifact_digest": {"type": "string"},
        "actor_run_id": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "required": {"type": "boolean"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_run_id", "change_author_run_id", "revision", "change_set_digest", "status"],
      "properties": {
        "reviewer_run_id": {"type": "string", "minLength": 1},
        "change_author_run_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "change_set_digest": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "INCOMPLETE"]}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "authority", "subject", "status"],
      "properties": {
        "kind": {"enum": ["INTENT", "POLICY", "RELEASE_RISK"]},
        "authority": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "status": {"enum": ["APPROVED", "REJECTED"]}
      }
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "approver", "subject", "rationale", "scope", "expires_at"],
      "properties": {
        "kind": {"enum": ["PROCESS", "AVAILABILITY", "TEMPORARY_POLICY"]},
        "approver": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
