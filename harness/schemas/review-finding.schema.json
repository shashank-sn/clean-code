{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/review-finding.schema.json",
  "title": "Clean Code review finding",
  "type": "object",
  "required": ["id", "severity", "behavior", "evidence", "consequence", "confidence", "fix", "disposition"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["BLOCKING", "IMPROVEMENT", "ADVISORY"] },
    "file": { "type": "string", "minLength": 1 },
    "line": { "type": "integer", "minimum": 1 },
    "behavior": { "type": "string", "minLength": 1 },
    "rule_id": { "type": "string" },
    "evidence": { "type": "string", "minLength": 1 },
    "consequence": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
    "fix": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["OPEN", "APPLIED", "DISMISSED", "ACCEPTED_RISK"] },
    "resolution_reason": { "type": "string" }
  },
  "additionalProperties": false
}
