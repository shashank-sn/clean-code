{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/adversarial-probe.schema.json",
  "title": "Clean Code adversarial probe plan",
  "type": "object",
  "required": ["schema_version", "revision", "risk", "probes", "repair_loop", "status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "revision": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["medium", "high"] },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "derived_from", "description", "executable", "status", "human_judgment_required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["primary_acceptance", "post_hoc_diagnostic"] },
          "derived_from": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "executable": { "type": "boolean" },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_AVAILABLE", "BLOCKED"] },
          "evidence": { "type": "string" },
          "human_judgment_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "repair_loop": { "const": "bounded_repair_reverify" },
    "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_AVAILABLE", "BLOCKED"] }
  },
  "additionalProperties": false
}
