{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","study_id","manifest_digest","outcomes"],"properties":{"schema_version":{"const":"1.0.0"},"study_id":{"type":"string","minLength":1},"manifest_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"outcomes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["repository","revision","run_id","artifact_digest","started_at","finished_at","task_id","arm","model","tools","limit","oracle","status","false_positives","correct_silence"],"properties":{"repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},"run_id":{"type":"string","minLength":1},"artifact_digest":{"type":"string","minLength":1},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"},"task_id":{"type":"string","minLength":1},"arm":{"enum":["control","workflow"]},"model":{"type":"string","minLength":1},"tools":{"type":"array","minItems":1},"limit":{"type":"integer","minimum":1},"oracle":{"type":"string","minLength":1},"status":{"enum":["PASS","FAIL","TIMEOUT"]},"false_positives":{"type":"integer","minimum":0},"correct_silence":{"type":"boolean"}}}}}}