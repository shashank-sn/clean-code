{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/check-result.schema.json",
  "title": "Clean Code check result",
  "type": "object",
  "required": ["schema_version", "check_id", "category", "provider", "status", "started_at", "duration_ms"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "check_id": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["PASS", "FAIL", "NOT_AVAILABLE", "NOT_CONFIGURED", "NOT_RUN", "STALE", "ERROR"]
    },
    "required": { "type": "boolean" },
    "revision": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exit_code": { "type": "integer" },
    "evidence": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "artifact_details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "schema", "revision", "fresh"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "schema": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "minLength": 1 },
              "fresh": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "baselines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact", "metric", "scope", "current", "baseline", "direction", "regressed"],
            "properties": {
              "artifact": { "type": "string", "minLength": 1 },
              "metric": { "type": "string", "minLength": 1 },
              "scope": { "enum": ["repository", "changed"] },
              "current": { "type": "number" },
              "baseline": { "type": "number" },
              "direction": { "enum": ["higher", "lower"] },
              "tolerance": { "type": "number", "minimum": 0 },
              "regressed": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
