{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/qa-procedure.schema.json",
  "title": "Clean Code UI QA procedure",
  "type": "object",
  "required": ["schema_version", "id", "requirement_ids", "preconditions", "steps"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "expected"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "accessibility": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "environments": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
