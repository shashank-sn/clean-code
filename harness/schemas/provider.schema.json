{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/provider.schema.json",
  "title": "Clean Code provider contract",
  "type": "object",
  "required": ["schema_version", "id", "category", "version", "languages", "command", "input", "output", "availability", "policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "category": { "enum": ["complexity", "mutation", "acceptance", "browser-qa", "dependency-graph", "architecture-render"] },
    "version": { "type": "string", "minLength": 1 },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "command": { "$ref": "#/$defs/command" },
    "input": { "$ref": "#/$defs/artifact" },
    "output": { "$ref": "#/$defs/artifact" },
    "availability": {
      "type": "object", "required": ["mode", "cost"],
      "properties": { "mode": { "enum": ["local", "optional"] }, "cost": { "enum": ["none", "external"] } },
      "additionalProperties": false
    },
    "policy": {
      "type": "object", "required": ["requires_trusted_policy", "network_access", "may_install_dependencies"],
      "properties": {
        "requires_trusted_policy": { "const": true },
        "network_access": { "const": false },
        "may_install_dependencies": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object", "required": ["format", "schema"],
      "properties": {
        "format": { "enum": ["file", "json", "xml", "sarif", "lcov", "text"] },
        "schema": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "required": ["id", "format", "schema", "required"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "format": { "enum": ["file", "json", "xml", "sarif", "lcov", "text"] },
              "schema": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" }
            }, "additionalProperties": false
          }
        }
      }, "additionalProperties": false
    },
    "command": {
      "type": "object", "required": ["id", "executable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 0 },
        "max_output_bytes": { "type": "integer", "minimum": 0 },
        "allowed_exit_codes": { "type": "array", "items": { "type": "integer" } },
        "required": { "type": "boolean" },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } },
        "shell": { "const": false },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object", "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "format": { "enum": ["file", "json", "xml", "sarif", "lcov", "text"] },
              "required": { "type": "boolean" },
              "fresh": { "type": "boolean" },
              "max_bytes": { "type": "integer", "minimum": 0 }
            }, "additionalProperties": false
          }
        },
        "baselines": {
          "type": "array",
          "items": {
            "type": "object", "required": ["artifact", "metric", "direction", "value"],
            "properties": {
              "artifact": { "type": "string", "minLength": 1 },
              "metric": { "type": "string", "minLength": 1 },
              "scope": { "enum": ["repository", "changed"] },
              "direction": { "enum": ["higher", "lower"] },
              "value": { "type": "number" },
              "tolerance": { "type": "number", "minimum": 0 },
              "required": { "type": "boolean" }
            }, "additionalProperties": false
          }
        }
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
