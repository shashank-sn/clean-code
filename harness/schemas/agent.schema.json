{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/agent.schema.json",
  "title": "Clean Code portable agent",
  "type": "object",
  "required": ["schema_version", "id", "title", "description", "instruction_file", "role", "workflow_phase", "input", "output", "evidence_requirements", "permissions", "stop_conditions", "tool_free_mode", "handoff_to"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^clean-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "instruction_file": { "const": "SKILL.md" },
    "role": { "type": "string", "minLength": 1 },
    "workflow_phase": { "type": "string", "minLength": 1 },
    "input": { "$ref": "#/$defs/io" },
    "output": { "$ref": "#/$defs/io" },
    "evidence_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "permissions": { "type": "array", "items": { "enum": ["read_repository", "write_repository", "execute_commands", "network", "browser_automation", "git_write", "pull_request_write", "subagents"] } },
    "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "tool_free_mode": {
      "type": "object",
      "required": ["available", "behavior", "unavailable_statuses"],
      "properties": {
        "available": { "const": true },
        "behavior": { "type": "string", "minLength": 1 },
        "unavailable_statuses": { "type": "array", "minItems": 1, "items": { "enum": ["NOT_AVAILABLE", "NOT_CONFIGURED", "NOT_RUN", "STALE", "ERROR"] } }
      },
      "additionalProperties": false
    },
    "handoff_to": { "type": "array", "items": { "type": "string", "pattern": "^clean-[a-z0-9-]+$" } }
  },
  "$defs": {
    "io": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "optional": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
