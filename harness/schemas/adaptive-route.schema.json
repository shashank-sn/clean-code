{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/adaptive-route.schema.json",
  "title": "Clean Code adaptive route decision",
  "type": "object",
  "required": ["schema_version", "playbook_id", "selected_roles", "required_evidence", "arena_warranted", "adversarial_probes_warranted", "allowed_parallelism", "reasons", "fallback", "authorization", "terminal_states"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "playbook_id": { "type": "string", "minLength": 1 },
    "selected_roles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "arena_warranted": { "type": "boolean" },
    "adversarial_probes_warranted": { "type": "boolean" },
    "allowed_parallelism": {
      "type": "object",
      "required": ["allowed", "max_concurrency", "eligible_roles", "mutation_policy"],
      "properties": {
        "allowed": { "type": "boolean" },
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "eligible_roles": { "type": "array", "items": { "type": "string" } },
        "mutation_policy": { "type": "string", "minLength": 1 },
        "unavailable_note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "fallback": {
      "type": "object",
      "required": ["playbook_id", "roles", "reason"],
      "properties": {
        "playbook_id": { "type": "string", "minLength": 1 },
        "roles": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "authorization": { "enum": ["advisory", "lifecycle_authorized"] },
    "terminal_states": {
      "type": "array",
      "items": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_AVAILABLE", "BLOCKED"] }
    }
  },
  "additionalProperties": false
}
