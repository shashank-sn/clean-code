{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/parallel-orchestration.schema.json",
  "title": "Clean Code parallel orchestration record",
  "type": "object",
  "required": ["schema_version", "revision", "coordinator", "why_parallel", "max_concurrency", "children", "human_approvals_held", "status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "revision": { "type": "string", "minLength": 1 },
    "coordinator": { "type": "string", "minLength": 1 },
    "why_parallel": { "type": "string", "minLength": 1 },
    "max_concurrency": { "type": "integer", "minimum": 1 },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "owned_scope", "evidence_request", "mutation_boundary", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "owned_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence_request": { "type": "string", "minLength": 1 },
          "mutation_boundary": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_AVAILABLE", "BLOCKED"] },
          "claimed_artifacts": { "type": "array", "items": { "type": "string" } },
          "verified_artifacts": { "type": "array", "items": { "type": "string" } },
          "failure_note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "synthesis_notes": { "type": "array", "items": { "type": "string" } },
    "human_approvals_held": {
      "type": "array",
      "minItems": 4,
      "items": { "enum": ["release", "policy", "permissions", "external_actions"] }
    },
    "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_AVAILABLE", "BLOCKED"] }
  },
  "additionalProperties": false
}
