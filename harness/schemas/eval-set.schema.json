{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/eval-set.schema.json",
  "title": "Clean Code evaluation set",
  "type": "object",
  "required": ["schema_version", "id", "title", "purpose", "case_ids", "calibration_case_ids", "held_out_case_ids", "created_by", "created_at", "status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "case_ids": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "calibration_case_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "held_out_case_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["DRAFT", "ACTIVE", "RETIRED"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
