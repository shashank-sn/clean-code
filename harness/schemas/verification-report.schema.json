{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/verification-report.schema.json",
  "title": "Clean Code verification report",
  "type": "object",
  "required": ["schema_version", "repository", "revision", "policy_source", "started_at", "finished_at", "complete", "results"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "repository": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "policy_source": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "complete": { "type": "boolean" },
    "policy_deltas": { "type": "array", "items": { "type": "string" } },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "check-result.schema.json" }
    }
  },
  "additionalProperties": false
}
