{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "endpoint", "model", "reasoning_effort", "max_output_tokens", "max_output_words", "execution_order", "store", "tools", "shared_instruction", "control_instruction", "workflow_instruction"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "provider": {"const": "openai"},
    "endpoint": {"const": "https://api.openai.com/v1/responses"},
    "model": {"type": "string", "pattern": "^gpt-5-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "reasoning_effort": {"enum": ["minimal", "low", "medium", "high"]},
    "max_output_tokens": {"type": "integer", "minimum": 1},
    "max_output_words": {"type": "integer", "minimum": 1},
    "execution_order": {"const": "alternating"},
    "store": {"const": false},
    "tools": {"type": "array", "maxItems": 0},
    "shared_instruction": {"type": "string", "minLength": 1},
    "control_instruction": {"type": "string", "minLength": 1},
    "workflow_instruction": {"type": "string", "minLength": 1}
  }
}
