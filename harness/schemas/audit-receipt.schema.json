{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/audit-receipt.schema.json",
  "title": "Audit receipt",
  "type": "object",
  "required": ["schema_version", "repository", "revision", "policy_revision", "created_at", "results", "requirements"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "policy_revision": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "results": { "type": "array", "items": { "type": "string" } },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "exceptions": { "type": "array", "items": { "type": "string" } },
    "spot_checks": { "type": "array", "items": { "type": "string" } },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
