{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/audit-receipt.schema.json",
  "title": "Clean Code audit receipt",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "revision",
    "policy_revision",
    "created_at",
    "complete",
    "artifacts",
    "gaps",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "complete": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "verification",
              "test-plan",
              "review",
              "spot-check",
              "supporting"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signing_key_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signed_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "signing_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "key_id",
          "public_key",
          "signature",
          "payload_sha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "implementer",
              "reviewer",
              "spot_checker"
            ]
          },
          "key_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
