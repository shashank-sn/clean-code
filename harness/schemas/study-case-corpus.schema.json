{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study_id": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "language", "requirement", "code", "response_format"], "properties": {"task_id": {"type": "string", "pattern": "^held-out-review-[0-9]{2}$"}, "language": {"type": "string", "minLength": 1}, "requirement": {"type": "string", "minLength": 1}, "code": {"type": "string", "minLength": 1}, "response_format": {"type": "string", "minLength": 1}}}}
  }
}
