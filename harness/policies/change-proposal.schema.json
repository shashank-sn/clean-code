{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-code.local/schemas/change-proposal.schema.json",
  "title": "Clean Code policy change proposal",
  "type": "object",
  "required": ["schema_version", "id", "source_receipt", "evidence_hashes", "kind", "target_class", "effect", "scope", "change", "benefit", "risks", "rollback", "calibration_fixture", "proposer", "status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "source_receipt": { "type": "string", "minLength": 1 },
    "evidence_hashes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "kind": { "enum": ["rule", "threshold", "adapter", "convention", "suppression", "calibration"] },
    "target_class": { "enum": ["quality", "convention", "correctness", "safety", "security", "privacy", "data-integrity", "requirement"] },
    "effect": { "enum": ["STRENGTHEN", "NEUTRAL", "WEAKEN"] },
    "scope": { "type": "string", "minLength": 1 },
    "change": { "type": "string", "minLength": 1 },
    "benefit": { "type": "string", "minLength": 1 },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rollback": { "type": "string", "minLength": 1 },
    "calibration_fixture": { "type": "string", "minLength": 1 },
    "proposer": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string" },
    "status": { "enum": ["PROPOSED", "APPROVED", "REJECTED", "ROLLED_BACK"] }
  },
  "additionalProperties": false
}
